{
  "name": "syft-api-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Syft Learning API on Cloudflare Workers + D1 (port of back/ Django backend)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute syft-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute syft-db --remote --file=./migrations/0001_initial.sql",
    "db:import": "node ./scripts/migrate-from-sqlite.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
