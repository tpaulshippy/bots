{
  "name": "syft-api-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Syft Learning API on Cloudflare Workers + D1 (port of back/ Django backend)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply syft-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply syft-db --remote",
    "db:import": "node ./scripts/migrate-from-sqlite.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
